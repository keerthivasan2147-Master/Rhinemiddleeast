@using Rhinemiddleeast.Models
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var requestToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var initialGreeting = ViewData["InitialGreeting"] as InitialGreetingModel ?? new InitialGreetingModel
    {
        ShouldGreet = true,
        GreetingEn = "Hi there, welcome to RHINE ! I’m your AI Assistant. Are you looking to build something new, improve your existing business, or automate your operations? I’m here to help.",
        GreetingAr = "مرحباً بك في RHINE! أنا مساعدك الذكي. هل تتطلع لبناء مشروع جديد، أو تطوير أعمالك القائمة، أو أتمتة عملياتك التشغيلية؟ أنا هنا لمساعدتك.",
        GreetingFa = "سلام، به RHINE خوش آمدید! من دستیار هوشمند شما هستم. آیا به دنبال ساخت کسب‌وکاری جدید، توسعه کسب‌وکار موجود یا خودکارسازی عملیات خود هستید؟ من آماده کمکم.",
        GreetingZh = "您好，欢迎来到 RHINE！我是您的人工智能助手。您是想构建新项目、改善现有业务，还是实现自动化运营？我随时为您提供帮助。"
    };
    var greetingJson = System.Text.Json.JsonSerializer.Serialize(initialGreeting);
}

<!-- Rhine AI Avatar Widget Integration -->
<link rel="stylesheet" href="~/avatar-widget/avatar-widget.css" asp-append-version="true" />
<script src="~/avatar-widget/avatar-widget.js" asp-append-version="true"></script>

<!-- Backdrop overlay for centered popup -->
<div id="rhineBackdrop" class="rhine-backdrop" aria-hidden="true"></div>

<script>
    var rhineServerGreeting = @Html.Raw(greetingJson);

    function initRhineAvatar() {
        if (!window.RhineAvatarWidget || window.rhineAvatar) return;

        var savedLang = (localStorage.getItem('rhine_lang') || '').toLowerCase();
        var browserLangs = (typeof navigator !== 'undefined' && navigator.languages) ? Array.from(navigator.languages) : [(navigator.language || '')];
        var docLang = (document.documentElement.getAttribute("lang") || "").toLowerCase();
        var docDir = (document.documentElement.getAttribute("dir") || "").toLowerCase();

        var initialLang = "en";
        if (savedLang === 'ar' || savedLang === 'en') {
            initialLang = savedLang;
        } else if (browserLangs.some(function(l) { return l.toLowerCase().startsWith('ar'); }) || docLang.startsWith('ar') || docDir === 'rtl') {
            initialLang = "ar";
        }

        var hasVisitedBefore = false;
        try {
            hasVisitedBefore = localStorage.getItem('rhine_visited_before') === 'true';
        } catch(e) {}

        var path = (window.location.pathname || "/").toLowerCase();
        var hash = (window.location.hash || "").replace("#", "").trim().toLowerCase();
        var hostname = (window.location.hostname || "").toLowerCase();
        var href = (window.location.href || "").toLowerCase();

        var isHomePath = (path === "/" || path === "" || path === "/home" || path === "/home/index" || path === "/index");
        var isRenderHost = hostname.includes("rhine-middle-east.onrender.com") || href.includes("rhine-middle-east.onrender.com");
        var isHomePage = (isHomePath && (!hash || hash === "home")) || (isRenderHost && isHomePath);

        // Auto-open popup on every homepage visit (new and returning visitors)
        // isNewVisitor controls whether to show browser mic permission prompt
        var isNewVisitor = !hasVisitedBefore;
        var shouldAutoOpen = isHomePage;

        var title = (initialLang === 'ar') ? "مساعد راين الذكي" :
                    (initialLang === 'fa') ? "دستیار هوشمند راین" :
                    (initialLang === 'zh') ? "RHINE 智能助手" : "RHINE AI Assistant";

        window.rhineAvatar = new window.RhineAvatarWidget({
            endpoint: "/api/agent/chat",
            statusEndpoint: "/api/agent/status",
            videoSrc: "/avatar-widget/assets/presenter.mp4",
            posterSrc: "/avatar-widget/assets/presenter-ai.png",
            kbUrl: null,
            title: title,
            language: initialLang,
            antiForgeryHeader: "RequestVerificationToken",
            antiForgeryToken: "@requestToken",
            serverGreeting: rhineServerGreeting,
            autoOpen: shouldAutoOpen,
            isNewVisitor: isNewVisitor
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener("DOMContentLoaded", initRhineAvatar);
    } else {
        initRhineAvatar();
    }

    // Fallback: ensure widget initializes if DOMContentLoaded already passed
    window.addEventListener("load", function () {
        if (!window.rhineAvatar) {
            initRhineAvatar();
        }
    });
</script>
