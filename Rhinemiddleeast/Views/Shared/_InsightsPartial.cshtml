<section class="page insights-page-section active" id="insights" aria-label="Insights">

    <!-- Full-width background image -->
    <div class="insights-bg-wrap" aria-hidden="true"></div>

    <!-- Dark left gradient overlay -->
    <div class="insights-overlay" aria-hidden="true"></div>

    <!-- Vertical right-side text stack -->
    @* <div class="insights-vertical-text" aria-hidden="true">
        <span>HUMAN</span>
        <span>IDEAS</span>
        <span>AGENT</span>
        <span>INTELLIGENCE</span>
        <span>A STRONGER</span>
        <span>TOMORROW</span>
        <span class="insights-vertical-line"></span>
    </div> *@

    <!-- Left-side main content -->
    <div class="insights-content">

        <!-- Eyebrow -->
        <div class="insights-eyebrow">
            <span class="insights-eyebrow-text">INSIGHTS</span>
            <span class="insights-eyebrow-line"></span>
        </div>

        <!-- Headline -->
        <h2 class="insights-headline">
            Thinking Beyond<br />
            <span class="insights-headline-gold">Today's AI.</span>
        </h2>

        <!-- Description -->
        <p class="insights-desc">
            Research, perspectives and ideas on AI Agents,<br />
            Agent Mentality, human–agent collaboration<br />
            and the systems shaping the future of work.
        </p>

        <!-- CTA Button -->
        <button type="button" class="insights-cta-btn" data-go="contact">
            <span>Explore Insights</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </button>

        <!-- Bottom tagline -->
        <div class="insights-tagline">
            <span class="insights-tagline-bar"></span>
            <span class="insights-tagline-text">IDEAS. PERSPECTIVES. PROGRESS.</span>
        </div>
    </div>

    

</section>
