<section class="page ourwork-page-section active" id="ourwork" aria-label="Our Work">

    <!-- Full-width clean background -->
    <div class="ourwork-bg-wrap" aria-hidden="true"></div>

    <!-- Soft lighting overlay for text readability -->
    <div class="ourwork-overlay" aria-hidden="true"></div>

  @*   <!-- Vertical right pillar text stack -->
    <div class="ourwork-vertical-text" aria-hidden="true">
        <span>REAL</span>
        <span>SOLUTIONS</span>
        <span>STRONGER</span>
        <span>COMMUNITIES</span>
        <span class="ourwork-vertical-line"></span>
    </div> *@

    <!-- Left-side main content -->
    <div class="ourwork-content">

        <!-- Eyebrow -->
        <div class="ourwork-eyebrow">
            <span class="ourwork-eyebrow-text">OUR WORK</span>
            <span class="ourwork-eyebrow-line"></span>
        </div>

        <!-- Headline -->
        <h2 class="ourwork-headline">
            Real Challenges.<br />
            <span class="ourwork-headline-gold">Practical Solutions.</span>
        </h2>

        <!-- Description -->
        <p class="ourwork-desc">
            We partner with businesses across industries<br />
            to turn complex challenges into measurable<br />
            results &mdash; creating value for people, operations<br />
            and communities.
        </p>

        <!-- CTA Button -->
        <button type="button" class="ourwork-cta-btn" data-go="contact">
            <span>Explore Our Work</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
        </button>

        <!-- Bottom Tagline -->
        <div class="ourwork-tagline">
            <span class="ourwork-tagline-bar"></span>
            <span class="ourwork-tagline-text">PEOPLE. SOLUTIONS. A BRIGHTER TOMORROW.</span>
        </div>

    </div>

</section>
