<!doctype html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>RHINE Middle East FZE — People and AI. Working for What's Next.</title>
    <meta name="description" content="RHINE designs industry-specific workforce platforms where human talent and governed AI agents work together to achieve real business outcomes." />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Outfit:wght@500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Favicon & Browser Tab Icon (Rhine 'R' matching logo) -->
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon-32x32.png" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/favicon-16x16.png" asp-append-version="true" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/apple-touch-icon.png" asp-append-version="true" />
    <link rel="shortcut icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="manifest" href="~/site.webmanifest" />
</head>
<body class="rhine-app-body">
    <!-- Header: Matches your design reference image precisely -->
    <header class="rhine-top-header" id="rhineHeader">
        <div class="header-inner">
            <!-- Brand Logo: RHINE MIDDLE EAST FZE without R mark -->
            <button class="brand-btn" data-go="home" aria-label="RHINE Middle East FZE Home">
                <img src="~/images/rhine-logo.png"
                     alt="RHINE MIDDLE EAST FZE"
                     class="brand-logo-img" />
            </button>

            <!-- Center Navigation Menu: Smooth switching without page reloads -->
            <nav class="center-nav" aria-label="Primary navigation">
                <button class="nav-item-btn active" data-go="home">Home</button>
                <button class="nav-item-btn" data-go="how">How It Works</button>
                <button class="nav-item-btn" data-go="agentfactory">Agent Factory</button>
                <button class="nav-item-btn" data-go="about">About Us</button>
                <button class="nav-item-btn" data-go="industries">Industries</button>
                <button class="nav-item-btn" data-go="ourwork">Our Work</button>
                <button class="nav-item-btn" data-go="insights">Insights</button>
            </nav>

            <!-- Right Actions: Golden Contact Us button + Language Selector -->
            <div class="header-right-actions">
                <button class="btn-gold-action" data-go="contact">Contact Us</button>

                <!-- Language Selector -->
                <div class="lang-selector dropdown">
                    <button class="btn-lang-toggle" type="button" id="langMenuBtn" data-bs-toggle="dropdown" aria-expanded="false">
                        <svg class="globe-svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="2" y1="12" x2="22" y2="12"></line>
                            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                        </svg>
                        <span class="lang-txt">EN</span>
                        <svg class="chevron-svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end lang-menu-dropdown" aria-labelledby="langMenuBtn">
                        <li><a class="dropdown-item active" href="javascript:void(0)" onclick="window.rhineApp.switchLang('EN')">English (EN)</a></li>
                        <li><a class="dropdown-item" href="javascript:void(0)" onclick="window.rhineApp.switchLang('AR')">العربية (AR)</a></li>
                    </ul>
                </div>
                <!-- Sidenav Toggle Button (Visible on Tablet & Mobile) -->
                <button class="sidenav-toggle-btn" id="sidenavToggleBtn" type="button" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="rhineSidenav">
                    <span class="hamburger-bar"></span>
                    <span class="hamburger-bar"></span>
                    <span class="hamburger-bar"></span>
                </button>
            </div>
        </div>
    </header>

    <!-- Sidenav Overlay Backdrop -->
    <div class="rhine-sidenav-overlay" id="sidenavOverlay" aria-hidden="true"></div>

    <!-- Sidenav Drawer (Menu available on Tablet & Mobile) -->
    <aside class="rhine-sidenav" id="rhineSidenav" aria-label="Mobile and Tablet navigation" aria-hidden="true">
        <div class="sidenav-header">
            <button class="brand-btn" data-go="home" aria-label="RHINE Middle East FZE Home">
                <img src="~/images/rhine-logo.png"
                     alt="RHINE MIDDLE EAST FZE"
                     class="sidenav-logo-img" />
            </button>
            <button class="sidenav-close-btn" id="sidenavCloseBtn" type="button" aria-label="Close navigation menu">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>

        <div class="sidenav-body">
            <nav class="sidenav-nav-list" aria-label="Sidebar navigation links">
                <button class="sidenav-link active" data-go="home">
                    <span class="sidenav-link-text">Home</span>
                </button>
                <button class="sidenav-link" data-go="how">
                    <span class="sidenav-link-text">How It Works</span>
                </button>
                <button class="sidenav-link" data-go="agentfactory">
                    <span class="sidenav-link-text">Agent Factory</span>
                </button>
                <button class="sidenav-link" data-go="about">
                    <span class="sidenav-link-text">About Us</span>
                </button>
                <button class="sidenav-link" data-go="industries">
                    <span class="sidenav-link-text">Industries</span>
                </button>
                <button class="sidenav-link" data-go="ourwork">
                    <span class="sidenav-link-text">Our Work</span>
                </button>
                <button class="sidenav-link" data-go="insights">
                    <span class="sidenav-link-text">Insights</span>
                </button>
                <button class="sidenav-link" data-go="contact">
                    <span class="sidenav-link-text">Contact Us</span>
                </button>
            </nav>
        </div>

        <div class="sidenav-footer">
            <button type="button" class="btn-gold-action w-100 mb-3" data-go="contact">
                <span>Contact Us &rarr;</span>
            </button>
            <div class="sidenav-lang-row">
                <span class="sidenav-lang-label">Language:</span>
                <div class="sidenav-lang-btns">
                    <button type="button" class="sidenav-lang-btn active" onclick="window.rhineApp.switchLang('EN')">English (EN)</button>
                    <button type="button" class="sidenav-lang-btn" onclick="window.rhineApp.switchLang('AR')">العربية (AR)</button>
                </div>
            </div>
        </div>
    </aside>

    <!-- Main Viewport Container -->
    <main role="main" class="rhine-main-viewport">
        @RenderBody()
    </main>




    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
