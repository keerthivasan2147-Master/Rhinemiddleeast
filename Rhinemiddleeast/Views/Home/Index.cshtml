<!-- Page 1: Landing Page (Uses full background image + exact right-aligned text content from reference image) -->
<section class="page active" id="home" aria-label="Home">
    <!-- Full-screen backdrop using the clean full image (Image 1) -->
    <div class="landing-full-bg" style="background-image: url('/images/landing-bg.jpg');">
