<!-- Page 2b: Agent Factory — Where Intelligent Agents Are Built -->
<section class="page agentfactory-page-section" id="agentfactory" aria-label="Agent Factory">

    <!-- Full-width background image: Agent-Factory.png -->
    <div class="agentfactory-bg-wrap" aria-hidden="true"></div>

    <!-- Soft gradient overlay for text readability -->
    <div class="agentfactory-overlay" aria-hidden="true"></div>

    <!-- Top right watermark / mezzanine branding -->
    <div class="agentfactory-watermark" aria-hidden="true">
        <span class="af-wm-tagline">DESIGN. BUILD. PREPARE.</span>
        <div class="af-wm-brand">
            <span class="af-wm-name">RHINE</span>
            <span class="af-wm-sub">MIDDLE EAST FZE</span>
        </div>
    </div>

    <!-- Far left vertical stack -->
    <div class="agentfactory-vertical-text" aria-hidden="true">
        <span>IDEAS</span>
        <span>TO AGENTS</span>
        <span class="agentfactory-vertical-line"></span>
        <span>REAL</span>
        <span>CAPABILITIES</span>
        <span class="agentfactory-vertical-line"></span>
        <span>REAL</span>
        <span>OUTCOMES</span>
    </div>

    <!-- Left-side main content overlay -->
    <div class="agentfactory-content">

        <!-- Eyebrow -->
        <div class="agentfactory-eyebrow">
            <span class="agentfactory-eyebrow-text">AGENT FACTORY</span>
        </div>

        <!-- Headline -->
        <h2 class="agentfactory-headline">
            Where Intelligent<br />
            Agents Are <span class="agentfactory-headline-gold">Built.</span>
        </h2>

        <!-- Description -->
        <p class="agentfactory-desc">
            From defining business roles to preparing real deployment,
            RHINE transforms operational needs into high-quality
            AI agents through a governed multi-stage
            production process.
        </p>

        <!-- CTA Buttons -->
        <div class="agentfactory-btn-row">
            <button type="button" class="agentfactory-btn-primary" data-go="contact">
                <span>Talk to RHINE &rarr;</span>
            </button>
            <button type="button" class="agentfactory-btn-secondary" data-go="home">
                <span>Back to Home</span>
            </button>
        </div>

    </div>

    <!-- 5-Stage Agent Factory Pipeline Cards (Define, Build, Challenge, Validate, Prepare) -->
    <div class="af-pipeline-container" aria-label="Agent Factory Pipeline Stages">
        <!-- Stage 1: DEFINE -->
        <div class="af-stage-card">
            <div class="af-card-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                    <line x1="10" y1="9" x2="8" y2="9"></line>
                </svg>
            </div>
            <h3 class="af-card-title">DEFINE</h3>
            <ul class="af-card-list">
                <li>ROLES</li>
                <li>GOALS</li>
                <li>KNOWLEDGE</li>
            </ul>
        </div>

        <div class="af-pipeline-arrow" aria-hidden="true">&gt;</div>

        <!-- Stage 2: BUILD -->
        <div class="af-stage-card">
            <div class="af-card-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                    <polyline points="2 17 12 22 22 17"></polyline>
                    <polyline points="2 12 12 17 22 12"></polyline>
                </svg>
            </div>
            <h3 class="af-card-title">BUILD</h3>
            <ul class="af-card-list">
                <li>TOOLS</li>
                <li>SKILLS</li>
                <li>CAPABILITIES</li>
            </ul>
        </div>

        <div class="af-pipeline-arrow" aria-hidden="true">&gt;</div>

        <!-- Stage 3: CHALLENGE -->
        <div class="af-stage-card">
            <div class="af-card-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
            </div>
            <h3 class="af-card-title">CHALLENGE</h3>
            <ul class="af-card-list">
                <li>TEST</li>
                <li>RED TEAM</li>
                <li>STRESS</li>
            </ul>
        </div>

        <div class="af-pipeline-arrow" aria-hidden="true">&gt;</div>

        <!-- Stage 4: VALIDATE -->
        <div class="af-stage-card">
            <div class="af-card-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    <polyline points="9 12 11 14 15 10"></polyline>
                </svg>
            </div>
            <h3 class="af-card-title">VALIDATE</h3>
            <ul class="af-card-list">
                <li>QUALITY</li>
                <li>SAFETY</li>
                <li>PERFORMANCE</li>
            </ul>
        </div>

        <div class="af-pipeline-arrow" aria-hidden="true">&gt;</div>

        <!-- Stage 5: PREPARE -->
        <div class="af-stage-card">
            <div class="af-card-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
            </div>
            <h3 class="af-card-title">PREPARE</h3>
            <ul class="af-card-list">
                <li>DEPLOY</li>
                <li>MONITOR</li>
                <li>SCALE</li>
            </ul>
        </div>
    </div>

    <!-- Bottom left desk badge -->
    <div class="agentfactory-desk-badge" aria-hidden="true">
        <span class="af-desk-title">INTELLIGENT AGENTS.</span>
        <span class="af-desk-subtitle">REAL WORK.</span>
        <span class="af-desk-gold-bar"></span>
    </div>

    <!-- Bottom right crate badge -->
    <div class="agentfactory-crate-badge" aria-hidden="true">
        <span>AI AGENTS</span>
        <span>FOR A BRIGHTER</span>
        <span>TOMORROW</span>
        <span class="af-crate-gold-bar"></span>
    </div>

</section>

