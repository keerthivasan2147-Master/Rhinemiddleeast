        <div class="landing-ambient-overlay"></div>

        <!-- Left-aligned content container matching Image 2 -->
        <div class="landing-content-container">
            <div class="landing-hero-card">
                <span class="landing-eyebrow">INTELLIGENT WORKFORCES FOR A REAL WORLD</span>

                <h1 class="landing-main-title">
                    People and AI.<br />
                    Working for <span class="hero-gold-text">What's Next.</span>
                </h1>

                <p class="landing-desc-text">
                    RHINE designs industry-specific operating platforms where human talent and governed AI agents work together as one coordinated workforce.
                </p>

                <div class="landing-action-row">
                    <button type="button" class="btn-gold-hero" data-go="agentfactory">
                        <span>Build Your Company &rarr;</span>
                    </button>
                    <button type="button" class="btn-secondary-hero" data-go="contact">
                        <span>Transform Your Company</span>
                    </button>
                </div>

